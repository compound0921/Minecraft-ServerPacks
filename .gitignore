# 构建输出：build.sh 组装出的可运行服务端目录。
# 其中 libraries/ versions/ .fabric/ *.jar 等均由 start 脚本运行时自动下载，
# 不进版本控制（详见 README）。
build/

# 打包好的成品 zip
dist/

# 兜底：若日后有包直接放在仓库根目录，同样排除这些产物
/libraries/
/versions/
/.fabric/
/server.jar
/fabric-server-launcher.jar
/manifest.json
/.previousrun
/run.sh
/run.bat
/user_jvm_args.txt
