# 构建输出：build.sh 组装出的可运行服务端目录。
# 其中 libraries/ versions/ .fabric/ *.jar 等均由 start 脚本运行时自动下载，
# 不进版本控制（详见 README）。
build/

# 打包好的成品 zip
dist/

# packs/<包名>/ 下一个文件都不进版本控制：内容全部来自 ServerPackCreator 的原始输出
# （构建前现拷进去），或由 build.sh 运行时从 shared/defaults/ 补出来。
# packs/.gitkeep 只占住 packs/ 这个目录本身，不在本规则范围内。
packs/*/*

# 兜底：若日后有包直接放在仓库根目录，同样排除这些产物
/libraries/
/versions/
/.fabric/
/server.jar
/fabric-server-launcher.jar
/manifest.json
/.previousrun
/run.sh
/run.bat
/user_jvm_args.txt
